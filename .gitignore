# Ignore Python bytecode and cache directories.
__pycache__/
*.py[cod]

# Ignore local Python virtual environments.
.venv/
venv/
env/

# Ignore environment files containing local settings or secrets.
.env
.env.*
!.env.example
.agents/

# Ignore uploaded documents while keeping the upload directory available.
uploads/*
!uploads/aa53f3fa396547cb87b9a79c4f1ba01b_CS232_CS332_Module06-Compute-Part1.pdf
!uploads/2aade10e3a2249a5a6f189455378f07f_CS232_CS332_Module06-Compute-Part2.pdf
!uploads/164c0a3bfe4f42979042b2490b580371_aa53f3fa396547cb87b9a79c4f1ba01b_CS232_CS332_Module06-Compute-Part1.pdf

# Ignore test, coverage, and tool cache files.
.pytest_cache/
.coverage
htmlcov/

# Ignore application and system log files.
*.log

# Ignore local Docker Compose override files.
docker-compose.override.yml

# Ignore local development progress notes.
process.txt

# Ignore operating-system and editor files.
.DS_Store
Thumbs.db
.idea/
.vscode/
